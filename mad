package com.example.rssfeedreader; 
import android.os.Bundle; 
import android.widget.*; 
import android.view.View; 
import android.content.Intent; 
import android.net.Uri; 
import androidx.appcompat.app.AppCompatActivity; 
import org.xmlpull.v1.XmlPullParser; 
import android.util.Xml; 
import java.net.URL; 
import java.net.HttpURLConnection; 
import java.util.ArrayList; 
import java.util.concurrent.Executors; 
public class MainActivity extends AppCompatActivity { 
Button btnLoad; 
ListView listView; 
ArrayList<String> titles = new ArrayList<>(); 
ArrayList<String> links = new ArrayList<>(); 
ArrayAdapter<String> adapter; 
String RSS_URL = "https://feeds.bbci.co.uk/news/rss.xml"; 
@Override 
protected void onCreate(Bundle savedInstanceState) { 
super.onCreate(savedInstanceState); 
setContentView(R.layout.activity_main); 
btnLoad = findViewById(R.id.btnLoad); 
listView = findViewById(R.id.listView); 
adapter = new ArrayAdapter<>( 
this, 
android.R.layout.simple_list_item_1, 
titles); 
listView.setAdapter(adapter); 
btnLoad.setOnClickListener(v -> loadRSS()); 
listView.setOnItemClickListener((p, v, pos, id) -> { 
startActivity(new Intent(Intent.ACTION_VIEW, 
Uri.parse(links.get(pos)))); 
}); 
} 
void loadRSS() { 
btnLoad.setEnabled(false); 
Executors.newSingleThreadExecutor().execute(() -> { 
ArrayList<String> newTitles = new ArrayList<>(); 
ArrayList<String> newLinks = new ArrayList<>(); 
try { 
HttpURLConnection con = 
(HttpURLConnection) new URL(RSS_URL).openConnection(); 
con.setConnectTimeout(10000); 
con.setReadTimeout(10000); 
XmlPullParser parser = Xml.newPullParser(); 
parser.setInput(con.getInputStream(), null); 
String title = "", link = ""; 
int event = parser.getEventType(); 
while (event != XmlPullParser.END_DOCUMENT) { 
if (event == XmlPullParser.START_TAG) { 
String tag = parser.getName(); 
 
                        if (tag.equals("item")) { 
                            title = ""; 
                            link = ""; 
                        } 
 
                        else if (tag.equals("title") && 
                                title.isEmpty()) { 
                            title = parser.nextText(); 
                        } 
 
                        else if (tag.equals("link") && 
                                link.isEmpty()) { 
                            link = parser.nextText(); 
                        } 
                    } 
 
                    else if (event == XmlPullParser.END_TAG && 
                            parser.getName().equals("item")) { 
 
                        if (!title.isEmpty() && !link.isEmpty()) { 
                            newTitles.add(title); 
                            newLinks.add(link); 
                        } 
                    } 
 
                    event = parser.next(); 
                } 
 
                con.disconnect(); 
 
} catch (Exception e) { 
e.printStackTrace(); 
} 
runOnUiThread(() -> { 
titles.clear(); 
links.clear(); 
titles.addAll(newTitles); 
links.addAll(newLinks); 
adapter.notifyDataSetChanged(); 
btnLoad.setEnabled(true); 
Toast.makeText(this, 
titles.isEmpty() ? "Failed to load RSS feed" 
: "RSS Feed Loaded", 
Toast.LENGTH_SHORT).show(); 
}); 
}); 
} 
} 
