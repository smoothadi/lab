package com.example.lab4_studentdatabaseapp; 
import android.content.*; 
import android.database.*; 
import android.database.sqlite.*; 
public class DatabaseHelper extends SQLiteOpenHelper { 
public DatabaseHelper(Context context) { 
super(context, "StudentDB.db", null, 1); 
} 
@Override 
public void onCreate(SQLiteDatabase db) { 
db.execSQL("CREATE TABLE students (id INTEGER PRIMARY KEY, " + 
"name TEXT, register_no TEXT, department TEXT)"); 
} 
@Override 
public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) { 
db.execSQL("DROP TABLE IF EXISTS students"); 
onCreate(db); 
} 
// Insert Student with smallest available ID 
public boolean insertStudent(String name, String reg, String dept) { 
SQLiteDatabase db = getWritableDatabase(); 
int id = 1; 
Cursor c = db.rawQuery("SELECT id FROM students ORDER BY id", null); 
while (c.moveToNext()) { 
if (c.getInt(0) == id) id++; 
else if (c.getInt(0) > id) break; 
} 
c.close(); 
ContentValues values = new ContentValues(); 
values.put("id", id); 
values.put("name", name); 
values.put("register_no", reg); 
values.put("department", dept); 
return db.insert("students", null, values) != -1; 
} 
// View All Students 
public Cursor getAllStudents() { 
return getReadableDatabase().rawQuery( 
"SELECT * FROM students ORDER BY id", null); 
} 
// Delete Student 
public boolean deleteStudent(String reg) { 
return getWritableDatabase().delete( 
"students", "register_no=?", new String[]{reg}) > 0; 
} 
} 
