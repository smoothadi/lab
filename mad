package com.studentdatabaseapp; 
import android.database.Cursor; 
import android.os.Bundle; 
import android.widget.*; 
import androidx.appcompat.app.AppCompatActivity; 
public class MainActivity extends AppCompatActivity { 
EditText editName, editRegister, editDepartment; 
Button buttonSave, buttonDelete; 
TextView textResult; 
DatabaseHelper databaseHelper; 
@Override 
protected void onCreate(Bundle savedInstanceState) { 
super.onCreate(savedInstanceState); 
setContentView(R.layout.activity_main); 
editName = findViewById(R.id.editName); 
editRegister = findViewById(R.id.editRegister); 
editDepartment = findViewById(R.id.editDepartment); 
buttonSave = findViewById(R.id.buttonSave); 
buttonDelete = findViewById(R.id.buttonDelete); 
textResult = findViewById(R.id.textResult); 
databaseHelper = new DatabaseHelper(this); 
displayStudents(); 
// SAVE STUDENT 
buttonSave.setOnClickListener(v -> { 
String name = editName.getText().toString().trim(); 
String reg = editRegister.getText().toString().trim(); 
String dept = editDepartment.getText().toString().trim(); 
if (name.isEmpty() || reg.isEmpty() || dept.isEmpty()) { 
Toast.makeText(this, "Enter all details", 
Toast.LENGTH_SHORT).show(); 
} else if (databaseHelper.insertStudent(name, reg, dept)) { 
Toast.makeText(this, "Student Saved", 
Toast.LENGTH_SHORT).show(); 
editName.setText(""); 
editRegister.setText(""); 
editDepartment.setText(""); 
displayStudents(); 
} else { 
Toast.makeText(this, "Save Failed", 
Toast.LENGTH_SHORT).show(); 
} 
}); 
// DELETE STUDENT 
buttonDelete.setOnClickListener(v -> { 
String reg = editRegister.getText().toString().trim(); 
if (reg.isEmpty()) { 
Toast.makeText(this, "Enter Register Number", 
Toast.LENGTH_SHORT).show(); 
} else if (databaseHelper.deleteStudent(reg)) { 
Toast.makeText(this, "Student Deleted", 
Toast.LENGTH_SHORT).show(); 
editRegister.setText(""); 
displayStudents(); 
} else { 
Toast.makeText(this, "Student Not Found", 
Toast.LENGTH_SHORT).show(); 
} 
}); 
} 
// DISPLAY STUDENTS AUTOMATICALLY 
private void displayStudents() { 
Cursor c = databaseHelper.getAllStudents(); 
StringBuilder result = new StringBuilder(); 
while (c.moveToNext()) { 
result.append("ID: ").append(c.getInt(0)) 
.append("\nName: ").append(c.getString(1)) 
.append("\nRegister No: ").append(c.getString(2)) 
.append("\nDepartment: ").append(c.getString(3)) 
.append("\n----------------------\n"); 
} 
c.close(); 
textResult.setText(result.length() == 0 ? 
"No students found." : result.toString()); 
} 
} 
