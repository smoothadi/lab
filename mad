package com.example.gameapp; 
import android.os.Bundle; 
import android.widget.*; 
import androidx.appcompat.app.AppCompatActivity; 
import java.util.Random; 
public class MainActivity extends AppCompatActivity { 
EditText guess; 
TextView result; 
int number; 
void newGame() { 
number = new Random().nextInt(10) + 1; 
result.setText("Guess a number!"); 
guess.setText(""); 
} 
@Override 
protected void onCreate(Bundle savedInstanceState) { 
super.onCreate(savedInstanceState); 
setContentView(R.layout.activity_main); 
guess = findViewById(R.id.guess); 
result = findViewById(R.id.result); 
Button check = findViewById(R.id.check); 
        Button restart = findViewById(R.id.restart); 
 
        newGame(); 
 
        check.setOnClickListener(v -> { 
            String s = guess.getText().toString(); 
 
            if (s.isEmpty()) { 
                guess.setError("Enter a number"); 
                return; 
            } 
 
            int n = Integer.parseInt(s); 
 
            if (n < 1 || n > 10) { 
                result.setText("Enter between 1 and 10"); 
            } else if (n == number) { 
                result.setText("Congratulations! You Win!"); 
            } else if (n < number) { 
                result.setText("Too Low! Try Again"); 
            } else { 
                result.setText("Too High! Try Again"); 
            } 
        }); 
 
        restart.setOnClickListener(v -> newGame()); 
    } 
} 
 
